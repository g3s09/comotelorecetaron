# Nunca subas .env.local ni una contraseña real a Git.
# Para reemplazar la clave que se entrega inicialmente, crea esta variable en Vercel.
# Si existe, solo este valor tendrá acceso al panel.
CTLR_ADMIN_TOKEN_V2=pega-aqui-una-clave-larga-y-unica

# Necesarias para guardar cambios del panel y subir fotos en Vercel.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-key
